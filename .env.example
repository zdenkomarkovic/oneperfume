# ============================================
# KOPIRATI u .env.local i popuniti vrednosti
# ============================================

# URL sajta (bez trailing slash)
NEXT_PUBLIC_SITE_URL=https://oneperfume.rs

# Naziv sajta
NEXT_PUBLIC_SITE_NAME=One Perfume

# Google Analytics (opciono)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Database (opciono, prilagodi po potrebi)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Auth secret (opciono - ako koristis NextAuth/Lucia)
# AUTH_SECRET=

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=oneperfume
DB_PASSWORD=
DB_NAME=oneperfume

# Admin panel (/admin): AUTH_SECRET min. 32 karaktera; ADMIN_* se koriste samo pri `npm run db:setup`
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Folder za slike dodate kroz admin (podrazumevano ./uploads)
# UPLOAD_DIR=

# Kartično plaćanje: prazno = isključeno (samo pouzeće), mock = test gateway (samo razvoj), allsecure = AllSecure
PAYMENT_PROVIDER=
# AllSecure (popuniti kad klijent dobije pristup)
ALLSECURE_API_URL=
ALLSECURE_API_KEY=
ALLSECURE_SECRET=
